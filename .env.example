# SAH Group — environment template
# Copy to `.env.local` and fill when integrating. Never commit secrets.

NEXT_PUBLIC_SITE_URL=https://sah.com.sa

# Feature flags (0/1) — all off by default in code if unset
# FEATURE_CMS=0
FEATURE_AUTH=0
# FEATURE_ZOHO_FORMS=0          # Server-only gate for /api/zoho/* (client always POSTs)
# FEATURE_NEWSLETTER=0          # Server-only gate for /api/newsletter (client always POSTs)
# FEATURE_BOOKINGS=0
# FEATURE_CHECKOUT=0
# FEATURE_VIDEO=0
# FEATURE_SALESIQ=0
# FEATURE_ANALYTICS=0
# FEATURE_SEARCH=0
# FEATURE_BLOG=0
# FEATURE_STORE=0

# Sanity (Phase 0 §2.2)
# Create the project + datasets at https://www.sanity.io/manage then fill these.
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=staging
# SANITY_API_READ_TOKEN=              # Viewer token — server only, never NEXT_PUBLIC_
# SANITY_API_WRITE_TOKEN=             # Editor/Admin — .env.local / password manager only, never commit
# SANITY_REVALIDATE_SECRET=           # random 32-char hex; webhook: POST {SITE_URL}/api/revalidate?secret=…
# Seed scripts (Phase 4): npm run seed:page-seo | seed:marketing | validate:marketing
# Dataset sync (destructive; npx sanity login as Administrator first):
#   npm run sync:sanity:staging-to-production
#   npm run sync:sanity:production-to-staging
# (delete/create/export use CLI login; import uses SANITY_API_WRITE_TOKEN — Editor is enough)

# Supabase (Phase 0 §2.3)
# Create a Cloud project at https://supabase.com/dashboard then fill these.
# Prefer a dedicated staging project now; add a separate production project when budget allows.
# Do not create tables yet — that is Phase 5 (auth / profiles).
# NEXT_PUBLIC_SUPABASE_URL=                 # Project Settings → API → Project URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY=            # Project Settings → API → anon public (safe for browser)
# SUPABASE_SERVICE_ROLE_KEY=               # Project Settings → API → service_role — server only, never NEXT_PUBLIC_
# Auth redirect allowlist (Authentication → URL Configuration):
#   http://localhost:3000/auth/callback
#   http://localhost:3000/auth/callback/**
#   staging + production equivalents
# For local reset emails, set Site URL to http://localhost:3000 while testing.

# Zoho One (Phase 2 — CRM OAuth; SA data center)
# Create a Server-based OAuth client at https://api-console.zoho.com/
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=                        # include ZohoCampaigns.contact.ALL for newsletter
# ZOHO_API_BASE=https://www.zohoapis.sa
# ZOHO_CAMPAIGNS_API_BASE=https://campaigns.zoho.sa
# ZOHO_CAMPAIGNS_LIST_KEY=                    # no inline comments on this line — Next keeps them in the value
# ZOHO_BOOKINGS_ORG_ID=                       # Phase 7 — bookings
# NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET=            # out of scope

# Payments — Moyasar + Tamara (not Stripe)
# NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
# MOYASAR_SECRET_KEY=
# MOYASAR_WEBHOOK_SECRET=
# TAMARA_API_TOKEN=
# TAMARA_NOTIFICATION_TOKEN=

# Video — Mux (Phase 0 §2.4)
# Create an account at https://dashboard.mux.com then fill these.
# Access Token: Settings → Access Tokens. Permissions: Video Read + Write, Data Read, System Read + Write.
# Signing key: Settings → Signing Keys (needed for signed playback in Phase 9).
# All Mux keys are server-only — never NEXT_PUBLIC_. Do not install @mux/* until Phase 9.
# VIDEO_PLATFORM=mux
# MUX_TOKEN_ID=                    # Access Token ID — server only
# MUX_TOKEN_SECRET=                # Access Token secret — shown once; store in a password manager
# MUX_SIGNING_KEY_ID=              # Signing key ID
# MUX_SIGNING_PRIVATE_KEY=         # PEM; escape newlines as \n (one line)

# Analytics
# All of the below are public IDs — they ship in the page source by design.
# NONE of them load anything unless FEATURE_ANALYTICS=1 AND the visitor has
# accepted the cookie banner. Do not put secrets or API keys here.
# No inline `# comments` after the `=` — Next keeps them in the value.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=0000000
# Full PageSense CDN script URL (host is data-centre specific, e.g. .sa / .com / .eu)
NEXT_PUBLIC_ZOHO_PAGESENSE_SRC=https://cdn.pagesense.io/js/ORG/PROJECTKEY.js
# SalesIQ widget code. One brand serves both locales — set the brand's chat
# language to "Website Language" so it follows <html lang> on each page.
NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET=
